{
  "name": "agent-packs",
  "version": "1.0.0",
  "description": "Universal AI Agent Skills Package Manager & Distribution Engine",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "agent-packs": "bin/run.js",
    "agentpacks": "bin/run.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ali-Ch-001/awesome-agent-packs.git"
  },
  "bugs": {
    "url": "https://github.com/Ali-Ch-001/awesome-agent-packs/issues"
  },
  "homepage": "https://github.com/Ali-Ch-001/awesome-agent-packs#readme",
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/registry/matrix.json', 'dist/registry/matrix.json')\"",
    "dev": "tsc --watch",
    "lint": "echo \"CLI syntax OK\"",
    "typecheck": "tsc --noEmit",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "agent-packs",
    "agentpacks",
    "awesome-agent-packs",
    "ai-agents",
    "claude-skills",
    "opencode",
    "cursor-rules",
    "mcp",
    "prompt-engineering"
  ],
  "author": "Ali Mohsin",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.9.1",
    "commander": "^13.1.0",
    "js-tiktoken": "^1.0.21",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "typescript": "^5.7.2"
  }
}
